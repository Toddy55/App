{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "$code": {
        ".read": "auth != null && $code.length >= 6",
        "groups": {
          "$group": {
            ".write": "auth != null && $group.length <= 12 && (!data.exists() || data.child('owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['owner', 'data', 'status', 'updatedAt']) && newData.child('owner').val() === auth.uid && newData.child('data').isString() && newData.child('data').val().length < 300000",
            "status": {
              ".validate": "newData.val() === 'live' || newData.val() === 'final'"
            }
          }
        }
      }
    },
    "marks": {
      "$key": {
        ".read": "auth != null && $key.length >= 16",
        "$id": {
          ".write": "$key.length >= 16 && $key.length <= 32 && $id.length === 20 && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['lat', 'lon'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lon": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "$other": {
            ".validate": false
          },
          "club": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      }
    }
  }
}
